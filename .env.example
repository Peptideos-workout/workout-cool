# Database Configuration
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=workout-cool
DB_HOST=localhost
# Host port mapped to the compose Postgres container (avoid 5432 if another stack uses it, e.g. Open Wearables).
DB_PORT=5433
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Prefer double-quotes when the URL contains & query params (safer with some Windows tooling).
DATABASE_URL="postgresql://username:password@localhost:5432/workout-cool"
#
# Supabase pooled runtime (Docker-friendly): DATABASE_URL=*pooler*:6543*pgbouncer=true*
# Vercel production DATABASE_URL must be the Supabase transaction pooler URI (port 6543) with pgbouncer=true and connection_limit=1.
# Placeholder shape only: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (migrate / Prisma): Supabase Dashboard → Connect → Postgres → URI, host db.<ref>.supabase.co:5432
# IMPORTANT: username must be `postgres` — not postgres.<ref> (that form is for the pooler only; wrong user → P1000 auth failed).
# DIRECT_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require"
# Shared Supabase: first `migrate` often errors P3005 (DB not empty globally). Bootstrap once — creates `wc.*` only, then registers history:
#   npm run db:bootstrap:w:direct
# Prisma stores Workout.cool in schema `wc` (multiSchema) so Migrate never touches PeptideOS `public.*` or Supabase `auth.*`.
# Routine deploys after bootstrap: npm run db:migrate:direct
# Alias same as migrate:direct: npm run db:baseline:direct
# NEVER `prisma db push` against shared prod DB.
# Startup runs `prisma migrate deploy` inside the container once DIRECT_DATABASE_URL is set.
# Alternative (PowerShell one-shot): $env:DATABASE_URL="<direct-uri>"; npx prisma migrate deploy — then restore pooled DATABASE_URL.
# Keep SEED_SAMPLE_DATA=false unless you intend to import WC sample CSV after migrations succeeded.
SKIP_DB_MIGRATE=0

# Authentication
# The URL where your application is running
BETTER_AUTH_URL=http://localhost:3000
# Generate a secure random string using: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Google OAuth
# Get these from Google Cloud Console: https://console.cloud.google.com
# Required scopes: email, profile
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenPanel Integration
# Get these from your OpenPanel dashboard
OPENPANEL_SECRET_KEY=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Optional Gatekeeper CMP (large "Privacy Preferences" / Do Not Sell UI). Omit or false = scripts not loaded (e.g. workouts.peptideos.us).
#NEXT_PUBLIC_ENABLE_GATEKEEPER_CONSENT=true

# Environment
# Options: development, production, test
NODE_ENV=development

#SMTP Configuration
# Using MailHog for example. https://github.com/mailhog/MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Workout Cool <noreply@workout.cool>"
SMTP_SECURE=false

# Whether to seed sample data on startup (requires migrations + exercises table — leave false until schema exists)
SEED_SAMPLE_DATA=false

# ========================================
# BILLING CONFIGURATION
# ========================================

# Stripe Configuration (optional)
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs
# Create products in Stripe Dashboard and add price IDs here
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_EU="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_EU="price_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_US="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_US="price_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_LATAM="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_LATAM="price_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_BR="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_BR="price_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_RU="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_RU="price_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_CN="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_CN="price_..."

# RevenueCat Configuration (for mobile app integration)
REVENUECAT_API_KEY=""
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_SECRET_KEY="test_secret_key"

# Billing Mode for self-hosted
# Options: DISABLED, LICENSE_KEY, SUBSCRIPTION, FREEMIUM
DEFAULT_BILLING_MODE="DISABLED"

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reverse of PeptideOS NEXT_PUBLIC_WORKOUT_COOL_URL. Optional.
# Production pairing: workouts.peptideos.us → https://peptideos.us (derived automatically).
# NEXT_PUBLIC_PEPTIDEOS_URL=https://peptideos.us
